<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                    https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">

    <persistence-unit name="minibank-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.minibank.model.Client</class>
        <class>com.minibank.model.Account</class>
        <class>com.minibank.model.Transaction</class>

        <properties>
            <!-- Подключение к PostgreSQL -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/minibank"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="secret"/>

            <!-- Проверка схемы -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Логирование SQL-запросов в консоль -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
